includes:
    - ../../../../mnt/storagebox2-coding/raw/WCF-6.2/phpstan-ambient.neon
    - phpstan-ambient.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    phpVersion:
        min: 80302
        max: 80499
    paths:
        - files
    scanDirectories:
        - ../../../../mnt/storagebox2-coding/raw/WCF-6.2/wcfsetup/install/files
    scanFiles:
        - constants.php
        - ../../../../mnt/storagebox2-coding/raw/WCF-6.2/constants.php
    ignoreErrors:
        - identifier: match.unhandled
        - identifier: method.unused
        - identifier: new.static
        - identifier: trait.unused 
